# ── Environment selector ─────────────────────────────────────────────────────
# Two INDEPENDENT axes:
#   CC_ENV  = onprem | cloud   → which PLATFORM (ExtJS vs gw-action markup)
#   CC_TIER = test   | dev     → which INSTANCE of that platform
CC_ENV=onprem
CC_TIER=test

# ── URLs ─────────────────────────────────────────────────────────────────────
CC_BASE_URL_ONPREM_TEST=http://test-claimcenter.donegalgroup.com/cc/ClaimCenter.do
CC_BASE_URL_ONPREM_DEV=http://dev-claimcenter.donegalgroup.com:8080/cc/ClaimCenter.do
CC_BASE_URL_CLOUD_TEST=https://cc-test-dngldev.donegal.beta5-andromeda.guidewire.net/ClaimCenter.do
CC_BASE_URL_CLOUD_DEV=https://cc-dev-dngldev.donegal.beta5-andromeda.guidewire.net/ClaimCenter.do

# Hard override beating BOTH selectors above - leave unset.
# CC_BASE_URL=

# ── Per-tier policies and per-policy loss dates ──────────────────────────────
# getNextPolicy() prefers POLICY_<KEY>_<TIER> over POLICY_<KEY>, so a dev
# instance's own policy population lives alongside the test one.
# POLICY_HO_PA_DEV=1001002540
# POLICY_PA_AUTO_DEV=1001001487
# A policy is only in force for its own term, so fixed/older policies need
# their loss date pinned (beats TEST_LOSS_DATE and the "yesterday" default):
# LOSSDATE_1001002540=05/28/2026
# LOSSDATE_1001001487=10/11/2021

# ── Credentials ───────────────────────────────────────────────────────────────
CC_USER=su
CC_PASS=Donegal2019

# ── Policy numbers (same across both envs if policies are synced) ─────────────
POLICY_PA_AUTO=1002239222
POLICY_MI_AUTO=1002216674
POLICY_HO_PA=XXXX-000003
POLICY_HO_VA=XXXX-000004
POLICY_WC_PA=XXXX-000005
POLICY_WC_MI=XXXX-000006
POLICY_BOP_PA=XXXX-000007
POLICY_BOP_DE=XXXX-000008
POLICY_CP_PA=XXXX-000009
POLICY_CP_MI=XXXX-000010
POLICY_CAU_PA=XXXX-000011
POLICY_CAU_MI=XXXX-000012
POLICY_FARM_PA=XXXX-000013
POLICY_FARM_VA=XXXX-000014
POLICY_DF_PA=XXXX-000015
POLICY_GL_IA=XXXX-000016
POLICY_IM_PA=XXXX-000017
POLICY_FF_PA=XXXX-000018

# Preferred Assign Claim assignee (a user that holds "Claim own").
# Optional: without it assignClaim walks candidates until one is accepted.
CC_ASSIGNEE_NAME=

# Email reporting (per-run report). Internal relay accepts unauthenticated
# mail, so EMAIL_SMTP_USER/PASS can be left blank - the reporter then omits
# the SMTP auth block entirely. Without EMAIL_SMTP_HOST the reporter no-ops.
EMAIL_SMTP_HOST=smtp.donegalgroup.com
EMAIL_SMTP_PORT=25
EMAIL_TO=
EMAIL_FROM=automation@donegalgroup.com
