+    const run = store.getRun(req.params.id);
+    if (!run) return res.status(404).json({ error: 'Run not found' });
+    res.json({ run, compare: store.compareWithPrevious(req.params.id) });
+  } catch (e) { res.status(500).json({ error: e.message }); }
+});
